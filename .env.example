# Contract Sphere AI - Environment Configuration Template
# Copy this file to .env and update the values before starting Docker Compose.

# ---------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------------------------
# Master password for the PostgreSQL superuser (postgres).
# CHANGE THIS to a strong password in production.
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# JWT Authentication Configuration
# ---------------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens.
# MUST be at least 32 characters long. Use a cryptographically random string.
# Generate one with: openssl rand -hex 32
JWT_SECRET=dev-secret-please-change-this-to-32-chars-min

# ---------------------------------------------------------------------------
# Ollama / LLM Configuration
# ---------------------------------------------------------------------------
# Base URL of your local Ollama server.
# Default: http://host.docker.internal:11434
# - On Docker Desktop (Windows/macOS): keep the default, it routes to the host.
# - On Linux Docker: ensure Ollama is reachable. Options:
#     a) Run Ollama on the host and bind to 0.0.0.0
#        (OLLAMA_HOST=0.0.0.0 ollama serve)
#     b) Add Ollama as a service in docker-compose.yml and use
#        http://ollama:11434 here.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Name of the Ollama model to use for contract drafting and AI features.
# Make sure the model is pulled BEFORE starting the backend, e.g.:
#   ollama pull llama3.1:8b-instruct
# Other good options:
#   - mistral:7b-instruct
#   - qwen2.5:7b-instruct
#   - deepseek-coder-v2:16b (requires more VRAM)
OLLAMA_MODEL=llama3.1:8b-instruct

# ---------------------------------------------------------------------------
# Blockchain Notary Configuration (Optional)
# ---------------------------------------------------------------------------
# Set to "true" to enable on-chain notarization of contract hashes.
# When disabled (default), no blockchain transactions are sent.
BLOCKCHAIN_NOTARY_ENABLED=false

# JSON-RPC URL for an Ethereum-compatible node (e.g. Sepolia, Polygon, etc.)
# You can use a provider like Infura, Alchemy, or your own node.
# Example (Sepolia via Infura): https://sepolia.infura.io/v3/YOUR_PROJECT_ID
BLOCKCHAIN_NOTARY_RPC_URL=

# Private key (hex, without 0x prefix) of the wallet that funds notarization.
# KEEP THIS SECRET. Do NOT commit the real value to version control.
BLOCKCHAIN_NOTARY_PRIVATE_KEY=

# Optional: target "to" address for notarization transactions (can be any
# address; the hash is stored in the transaction input data).
BLOCKCHAIN_NOTARY_TO_ADDRESS=

# Optional: chain ID (default 11155111 = Sepolia testnet)
# BLOCKCHAIN_NOTARY_CHAIN_ID=11155111
# BLOCKCHAIN_NOTARY_GAS_LIMIT=100000
# BLOCKCHAIN_NOTARY_POLL_INTERVAL_MS=1000
# BLOCKCHAIN_NOTARY_RECEIPT_ATTEMPTS=45

# ---------------------------------------------------------------------------
# JVM / Backend Memory Tuning (Optional)
# ---------------------------------------------------------------------------
# Heap size for the Spring Boot backend.
# Adjust if you have more / less RAM available.
JAVA_OPTS=-Xmx512m -Xms256m
